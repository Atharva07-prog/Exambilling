<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/exam_logo"
        android:label="@string/exam_billing_system"
        android:roundIcon="@drawable/exam_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Exambilling"
        tools:targetApi="31">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity"/>
        <activity android:name=".AdminActivity" />
        <activity android:name=".UserActivity" />
        <activity android:name=".RegistrationActivity" />
        <activity android:name=".ManageUsersActivity" />
        <activity android:name=".ManageTeachersActivity" />
        <activity android:name=".ChatActivity" />

    </application>

</manifest>